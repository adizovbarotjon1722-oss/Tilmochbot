# =====================================================================
#  TILMOCH BOT — sozlamalar. Ushbu faylni ".env" nomi bilan nusxalang.
# =====================================================================

# --- 0. BREND ---
BOT_NAME=Tilmoch — Xitoy · Ingliz · Rus tarjimon
BRAND=Tilmoch

# --- 1. ASOSIY (majburiy) ---
# @BotFather -> /newbot orqali olingan token
BOT_TOKEN=8862462429:AAF22718OSPSciE6AR2J-y7CzvML2eL0u68
# Sizning Telegram ID'ingiz (@userinfobot dan bilib oling). Bir nechta bo'lsa vergul bilan.
ADMIN_IDS=602455217
TIMEZONE=Asia/Tashkent

# --- 2. SUN'IY INTELLEKT TARJIMA + RASM O'QISH (ixtiyoriy, tavsiya etiladi) ---
# Variant A — OpenAI (tarjima + rasm o'qish):
#   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini   LLM_VISION=1
# Variant B — DeepSeek (eng arzon, faqat matn):
#   LLM_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat LLM_VISION=0
# Bo'sh qolsa — bepul Google Translate va Tesseract OCR ishlaydi.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_VISION=1
# 1 = AI tarjima faqat Premium/Biznes foydalanuvchilar uchun (xarajatni nazorat qilish)
LLM_PREMIUM_ONLY=1

# --- 3. OVOZNI TANISH (ixtiyoriy) ---
# Groq bepul kaliti: https://console.groq.com/keys  (Whisper large-v3, juda aniq)
# Bo'sh qolsa — bepul Google nutqni tanish ishlaydi.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
MAX_VOICE_SEC=300

# --- 4. TARIFLAR VA LIMITLAR ---
FREE_TEXT_LIMIT=30
FREE_VOICE_LIMIT=5
FREE_PHOTO_LIMIT=3
FREE_DOC_LIMIT=1
# Narxlar (so'm va Telegram Stars)
PRICE_PREMIUM_UZS=19000
PRICE_PREMIUM_STARS=100
PRICE_PREMIUM3_UZS=49000
PRICE_PREMIUM3_STARS=250
PRICE_BUSINESS_UZS=99000
PRICE_BUSINESS_STARS=500
# Click yoki Payme: @BotFather -> /mybots -> Bot -> Payments -> Click/Payme -> token
# Bo'sh qolsa — faqat Telegram Stars orqali to'lov.
PAYMENT_PROVIDER_TOKEN=

# --- 5. O'SISH ---
# Majburiy obuna kanali (masalan @mening_kanalim). Bot kanalda ADMIN bo'lishi shart. Bo'sh = o'chiq.
REQUIRED_CHANNEL=
# Necha do'st taklif qilinsa, necha kun Premium beriladi
REFERRAL_TARGET=3
REFERRAL_BONUS_DAYS=7
# Yangi foydalanuvchiga sovg'a Premium (kun). 0 = o'chiq
WELCOME_BONUS_DAYS=3
# Foydalanuvchilar soni shundan oshsa, /start da "N+ foydalanuvchi" ko'rsatiladi
SHOW_USERS_MIN=100
# Necha kun kirmaganlarga foydali "qaytarish" xabari yuboriladi va soat nechada
WINBACK_DAYS=3
WINBACK_HOUR=18

# --- 6. XAVFSIZLIK VA FON VAZIFALARI ---
DB_PATH=data/bot.db
BACKUP_DIR=data/backups
# Kunlik zaxira nusxa soati, nechta saqlansin, adminga yuborilsinmi
BACKUP_HOUR=3
BACKUP_KEEP=7
BACKUP_SEND_TO_ADMIN=1
# Maxfiy rejimdagi tarjimalar necha daqiqadan keyin o'chiriladi
PRIVATE_TTL_MIN=60
# Kunlik so'z testi soati
QUIZ_HOUR=10

# --- 7. OCR (rasm o'qish) tillari ---
TESSERACT_LANGS=uzb+eng+chi_sim+rus
